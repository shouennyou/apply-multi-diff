{
  "name": "apply-multi-diff-patch",
  "version": "0.1.4-patch.2",
  "description": "A zero-dependency library to apply unified diffs and search-and-replace patches, with support for fuzzy matching.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run scripts/update-timestamp.ts && tsup",
    "test": "bun test"
  },
  "private": true,
  "keywords": [
    "diff",
    "patch",
    "apply",
    "unified-diff",
    "search-replace",
    "fuzzy"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "bun-types": "latest",
    "js-yaml": "^5.5.0",
    "tsup": "^9.0.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
